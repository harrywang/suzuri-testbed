.DS_Store
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/

# generated by the latex/typst rendering checks
latex/*.pdf
typst/*.pdf
# Recursive: the conference fixtures live in subdirectories, and each
# preview regenerates these. Their reference PDFs are tracked deliberately,
# so the .pdf rules above stay one level deep.
latex/**/*.aux
latex/**/*.log
latex/**/*.bbl
latex/**/*.blg
latex/**/*.out
latex/**/*.toc
latex/**/*.fls
latex/**/*.fdb_latexmk
latex/**/*.synctex.gz
latex/**/missfont.log
